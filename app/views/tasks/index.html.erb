<h1>Tasks</h1>

<%= search_form_for @q, url: tasks_path, class: "mb-4" do |f| %>
  <div class="row">
    <!-- Keyword Search -->
    <div class="col-md-4">
      <div class="form-group">
        <%= f.label :title_or_description_cont, "Keyword Search" %>
        <%= f.search_field :title_or_description_cont, class: "form-control", placeholder: "Search in title or description" %>
      </div>
    </div>

    <!-- Status Search -->
<div class="col-md-3">
  <div class="form-group">
    <label>Status</label>
    <div>
      <div class="form-check">
        <%= f.radio_button :status_eq, "", 
                          class: "form-check-input", 
                          id: "status_all",
                          checked: params.dig(:q, :status_eq).blank? %>
        <%= f.label "status_all", "Not specified", class: "form-check-label" %>
      </div>

      <% Task.statuses.keys.each do |status| %>
        <div class="form-check">
          <%= f.radio_button :status_eq, status, 
                            class: "form-check-input", 
                            id: "status_#{status}" %>
          <%= f.label "status_#{status}", status.humanize, class: "form-check-label" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

    <!-- Deadline Search -->
    <div class="col-md-5">
      <div class="row">
        <div class="col-md-6">
          <div class="form-group">
            <%= f.label :deadline_gteq, "From Date" %>
            <%= f.date_field :deadline_gteq, class: "form-control" %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="form-group">
            <%= f.label :deadline_lteq, "To Date" %>
            <%= f.date_field :deadline_lteq, class: "form-control" %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-md-12">
      <%= f.submit "Search", class: "btn btn-primary mr-2" %>
      <%= link_to "Clear", tasks_path, class: "btn btn-secondary" %>
    </div>
  </div>
<% end %>

<table class="table">
  <thead>
    <tr>
      <th>Title</th>
      <th>Description</th>
      <th>
        <%= sort_link(@q, :deadline, 'Deadline') %>
      </th>
      <th>Status</th>
      <th>Priority</th>
      <th>Created At</th>
    </tr>
  </thead>
  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td><%= task.title %></td>
        <td><%= truncate(task.description, length: 50) %></td>
        <td>
          <% if task.deadline %>
            <%= task.deadline.strftime("%Y-%m-%d") %>
          <% else %>
            -
          <% end %>
        </td>
        <td>
          <span class="badge badge-<%= task_status_class(task.status) %>">
            <%= task.status.humanize %>
          </span>
        </td>
        <td><%= task.priority %></td>
        <td><%= task.created_at.strftime("%Y-%m-%d") %></td>
      </tr>
    <% end %>
  </tbody>
</table> 